<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.UserController"
            prefHeight="400.0"
            prefWidth="600.0">

    <VBox
            spacing="10"
            AnchorPane.topAnchor="10"
            AnchorPane.leftAnchor="10"
            AnchorPane.rightAnchor="10"
            AnchorPane.bottomAnchor="10">

        <!-- Search Field -->
        <TextField
                fx:id="searchField"
                promptText="Search by name or email"
                prefWidth="400.0"
                maxWidth="Infinity" />

        <!-- Input Fields -->
        <HBox spacing="10">
            <TextField
                    fx:id="nameField"
                    promptText="Name"
                    HBox.hgrow="ALWAYS" />

            <TextField
                    fx:id="emailField"
                    promptText="Email"
                    HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Buttons -->
        <HBox spacing="10">
            <Button text="Update User" onAction="#updateUser" />
            <Button text="Delete User" onAction="#deleteUser" />
        </HBox>

        <!-- Table View -->
        <TableView
                fx:id="tableView"
                VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn
                        text="ID"
                        fx:id="idColumn"
                        prefWidth="100.0" />

                <TableColumn
                        text="Name"
                        fx:id="nameColumn"
                        prefWidth="200.0" />

                <TableColumn
                        text="Email"
                        fx:id="emailColumn"
                        prefWidth="250.0" />
            </columns>
        </TableView>

    </VBox>
</AnchorPane>