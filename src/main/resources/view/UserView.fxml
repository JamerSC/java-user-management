<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.UserController"
            prefHeight="400.0" prefWidth="600.0">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <!-- Input Fields -->
        <HBox spacing="10">
            <TextField fx:id="nameField" promptText="Name" />
            <TextField fx:id="emailField" promptText="Email" />
        </HBox>

        <!-- Buttons -->
        <HBox spacing="10">
            <Button text="Update User" onAction="#updateUser" />
            <Button text="Delete User" onAction="#deleteUser" />
        </HBox>

        <!-- Table View -->
        <TableView fx:id="tableView">
            <columns>
                <TableColumn text="ID" fx:id="idColumn" />
                <TableColumn text="Name" fx:id="nameColumn" />
                <TableColumn text="Email" fx:id="emailColumn" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
